# Whitelist-style ignore: everything is ignored (`*`), only explicitly
# un-ignored (`!`) paths are tracked. TRAP: any NEW root-level or unlisted
# file (e.g. a new tooling config) is silently untracked — add a `!` rule
# for it here or `git add -f` deliberately.
*
!demo/
!demo/**
!docs/
!docs/**
!reference/
!reference/**
!.gitignore
!.gitattributes
!.editorconfig
!LICENSE
!README.md
!package.json
!package-lock.json
!tsconfig.json
!.prettierrc
!.prettierignore
!.nvmrc
!CONTRIBUTING.md
!scripts/
!scripts/**
!.github/
!.github/**