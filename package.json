{
  "name": "js-ts-basics-review",
  "version": "1.0.0",
  "description": "JavaScript and TypeScript basics review practice project",
  "type": "module",
  "scripts": {
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "demo": "node demo/01-basics/01-variables.js",
    "format": "node node_modules/prettier/bin/prettier.cjs --write \"demo/**/*.js\" \"demo/**/*.ts\" \"reference/*.json\" tsconfig.json",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check \"demo/**/*.js\" \"demo/**/*.ts\" \"reference/*.json\" tsconfig.json"
  },
  "keywords": [
    "javascript",
    "typescript",
    "learning",
    "practice",
    "basics"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.0"
  }
}
